    "lucide-react": "^0.563.0",
    "next": "^16.3.6",
    "next-intl": "^4.8.0",
    "nodemailer": "^9.1.1",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "3.4.10",
